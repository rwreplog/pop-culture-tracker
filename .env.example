# Copy to .env and fill in values.
# See src/lib/env.ts for validation — add new variables there when introduced.

# Matches the default docker-compose.yml Postgres service.
DATABASE_URL=postgresql://geekery:geekery@localhost:5432/geekery

# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Optional: set both to enable Google sign-in (see README for setup steps).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Media provider API keys. Leave unset to run without that provider's live search.
# TMDB_API_KEY=
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# COMICVINE_API_KEY=
# Optional: Google Books works unauthenticated, this just raises the rate limit.
# GOOGLE_BOOKS_API_KEY=

# Set to "fixture" to force deterministic in-memory search results instead of
# calling real provider APIs (used automatically in tests).
# MEDIA_PROVIDER_MODE=

# Neon Object Storage (custom art uploads). Provisioned via `neon.ts` /
# `neon deploy`; pull real values with `neon env pull`.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
